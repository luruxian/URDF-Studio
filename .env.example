# Same-server mesh preview from project A (optional)
VITE_MESH_PREVIEW_ALLOWED_ORIGINS=http://localhost:8000

# Agile Robot integration: origin(s) allowed to send robots:studio-bootstrap postMessage.
# Comma-separated, supports * wildcard (e.g. https://*.enkeebot.com,https://*.enkeebot.cn).
VITE_AGILE_ROBOT_ORIGINS=https://*.enkeebot.com,https://*.enkeebot.cn

# BYOK LLM — MiniMax / other OpenAI-compatible providers
VITE_OPENAI_API_KEY=your_api_key_here
VITE_OPENAI_MODEL=MiniMax-M3

# Browser cannot call MiniMax directly (CORS). Route through the dev-server proxy:
URDF_STUDIO_LLM_UPSTREAM=https://api.minimaxi.com
VITE_OPENAI_BASE_URL=/api/llm-proxy/v1

# International users: https://api.minimax.io/v1 upstream → URDF_STUDIO_LLM_UPSTREAM=https://api.minimax.io

# Optional: override OpenAI SDK extra_body JSON (MiniMax thinking is disabled by default for MiniMax-* models)
# VITE_OPENAI_EXTRA_BODY={"thinking":{"type":"disabled"},"reasoning_split":true}
